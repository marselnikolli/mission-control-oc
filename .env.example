# Gateway (Mission Control is just another operator client of it)
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=

# Where the Mission Control UI listens. Keep it on loopback and reach it over an SSH tunnel.
MC_HOST=127.0.0.1
MC_PORT=4400

# Your agents, in display order. The first one is the orchestrator.
MC_AGENTS=main,sysadmin,devops,security

# Handshake client identity. The docs example uses "cli"/"operator"; change if your Gateway rejects it.
MC_CLIENT_ID=cli
MC_CLIENT_MODE=operator

# Read-only by default. Set to 1 to request operator.approvals and enable the Approve/Reject buttons.
MC_ENABLE_APPROVALS=0
# RPC used to resolve an approval. Verify the name against your OpenClaw version before enabling.
MC_APPROVAL_METHOD=exec.approval.resolve

# Every raw Gateway frame is appended here so you can tune the normalizer to your version.
MC_RAW_LOG=logs/events.jsonl
