# Gateway (Mission Control is just another operator client of it)
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=

# Where the Mission Control UI listens. Keep it on loopback and reach it over an SSH tunnel.
MC_HOST=127.0.0.1
MC_PORT=4400

# Your agents, in display order. The first one is the orchestrator.
MC_AGENTS=main,sysadmin,devops,security

# Handshake client identity. The docs example uses "cli"/"operator"; change if your Gateway rejects it.
MC_CLIENT_ID=cli
MC_CLIENT_MODE=operator

# Read-only by default. Set to 1 to request operator.approvals and enable the Approve/Reject buttons.
MC_ENABLE_APPROVALS=0
# RPC used to resolve an approval. Verify the name against your OpenClaw version before enabling.
MC_APPROVAL_METHOD=exec.approval.resolve

# Every raw Gateway frame is appended here so you can tune the normalizer to your version.
MC_RAW_LOG=logs/events.jsonl

# Per-mission op history (missions.json index + one .jsonl file per mission) is written here.
MC_DATA_DIR=data

# Login is OFF by default (matches the old open-access behavior) until you set this.
# Comma-separated username:password:role entries, role is one of viewer/operator/admin.
# Operator+ is required to approve/reject; admin-only for the Audit Log panel.
# Example: MC_AUTH_USERS=alice:change-me:admin,bob:change-me-too:operator
MC_AUTH_USERS=

# Off by default. Set to 1 to enable the "New Task" button (Operator+) for submitting a new
# mission to the orchestrator from the UI. The RPC below is an UNVERIFIED PLACEHOLDER, same
# caveat as MC_APPROVAL_METHOD — confirm the real method name against your Gateway before relying on it.
MC_ENABLE_TASK_SUBMIT=0
MC_TASK_SUBMIT_METHOD=session.message.send

# RPC used by "View full output" on a tool card. Also an UNVERIFIED PLACEHOLDER — confirm
# against your Gateway (see README's "click a tool card to fetch full output" V2 idea).
MC_TOOL_OUTPUT_METHOD=chat.message.get

# Agent management RPCs used by the admin-only Agents panel (Stop/Restart/Pause/Resume, Edit
# config, Spawn helper agent). All three are UNVERIFIED PLACEHOLDERS — OpenClaw's Gateway may
# not implement any of them yet; calls just fail visibly in the UI (and are audited) until you
# confirm and set the real method names.
MC_AGENT_CONTROL_METHOD=agent.control
MC_AGENT_CONFIG_METHOD=agent.config.update
MC_AGENT_SPAWN_METHOD=agent.spawn

# RPC used by the Tools panel's per-agent-per-tool policy editor (allow/ask/deny) to try to push
# the change into OpenClaw's own config. UNVERIFIED PLACEHOLDER -- but the policy is saved
# locally in data/tool-policy.json regardless of whether this call succeeds, so the editor
# stays usable and consistent even against a Gateway that doesn't support it yet.
MC_TOOL_TOGGLE_METHOD=agent.tool.toggle

# If the Gateway connection fails this many times within this window, Mission Control stops
# exponential-backoff retrying (which would otherwise retry forever, ever slower) and falls
# back to one steady retry every MC_RECONNECT_COOLDOWN_MS instead.
MC_RECONNECT_MAX_FAILURES=5
MC_RECONNECT_WINDOW_MS=300000
MC_RECONNECT_COOLDOWN_MS=300000

# Token budgets (lifetime totals per agent, from graph.js's cumulative tokensIn/tokensOut --
# only populated when a Gateway event actually reports usage; see normalizer.js's usageOf()).
# 0 (the default) means unlimited -- nothing changes unless you set one of these.
# A warning banner shows at 80% of a limit, "exceeded" at 100%+; set MC_BUDGET_AUTO_PAUSE=1 to
# also call the (unverified-placeholder) agent-pause RPC when an agent's own budget is exceeded.
MC_BUDGET_TOKENS_PER_AGENT=0
MC_BUDGET_TOKENS_GLOBAL=0
MC_BUDGET_AUTO_PAUSE=0

# Secrets: nothing above needs a code change to come from a secrets manager instead of this
# plaintext file -- OPENCLAW_GATEWAY_TOKEN, MC_AUTH_USERS, etc. are read from process.env like
# any other env var, and this file is only consulted when a given var isn't already set. So
# `vault kv get -format=json ... | mission-control-wrapper.sh` (export the secrets, then exec
# `node server.js`), a systemd `EnvironmentFile=` pointed at a SOPS-decrypted file, or Docker's
# own secrets/`env_file` mechanisms all work without touching this project's code. Just don't
# also commit real values into an actual `.env` next to this example file.

# Outbound webhooks: comma-separated event:url pairs (a URL's own :// is fine, only the first
# colon in each entry is the split point). Repeat an event to notify more than one URL.
# Events: mission.start, approval.waiting, agent.error, mission.done (not yet reachable -- see
# plan.md Phase 9's status note). See API.md for the payload shape.
# Example: MC_WEBHOOKS=approval.waiting:https://hooks.slack.com/services/...,agent.error:https://example.com/hook
MC_WEBHOOKS=
